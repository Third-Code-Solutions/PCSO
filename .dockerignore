# Dependencies / build output (rebuilt inside the image)
node_modules
.next
out
build
dist
tsconfig.tsbuildinfo

# Version control / editors
.git
.gitignore
.idea
.vscode

# Environment files — secrets must never enter the build context.
# NEXT_PUBLIC_* values are passed as build args instead (see Dockerfile).
.env
.env.*
!.env.example

# Tests / tooling artifacts
coverage
playwright-report
test-results
e2e

# Docs and local artifacts not needed at runtime
docs
screenshots
outputs
README.md
CLAUDE.md
TOR-HS-System.md
PLANTILLA_IMPLEMENTATION_STATUS.md

# Docker files themselves
Dockerfile
docker-compose.yml
.dockerignore

# Logs
*.log
npm-debug.log*
