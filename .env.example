# Supabase — create at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Postgres direct connection (Drizzle migrations)
DATABASE_URL=postgresql://postgres:password@db.YOUR_PROJECT.supabase.co:5432/postgres

# Document signing (JWT) - use a long random value (32+ chars)
JWT_SECRET=replace-with-strong-random-secret-min-32-chars

# Email (Resend)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="PCSO HRS <no-reply@pcso.gov.ph>"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Philippine Charity Sweepstakes Office (PCSO) Human Resource System"

# Monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Scheduled jobs — bearer token for /api/cron/* endpoints.
# Vercel Cron sends it automatically when set; required for cron jobs to run.
CRON_SECRET=replace-with-long-random-secret

# Feature flags
ENABLE_BIOMETRIC_IMPORT=false

# Local seed only (scripts/seed-auth-users.ts). Never commit real values.
# Per-role override: SEED_<ROLE>_PASSWORD, e.g. SEED_HR_ADMIN_PASSWORD
SEED_DEFAULT_PASSWORD=

# Smoke/route test scripts (scripts/smoke-test.ts, test-*.ts) — local only,
# never commit real values.
SMOKE_ADMIN_EMAIL=
SMOKE_ADMIN_PASSWORD=
